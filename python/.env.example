# DevBuddy — Environment Configuration
#
# Copy this file to .env and add your OpenRouter API key.
# .env is git-ignored — never commit real keys.
#
# Every value here is read by src/config.py and nowhere else. Defaults live in
# the Settings class, so you only need to set what you want to override.

OPENROUTER_API_KEY=sk-or-your-key-here

# Default model (any OpenRouter model string).
# Needs reliable structured output + tool calling for Weeks 2-6.
DEVBUDDY_MODEL=openai/gpt-4o-mini

# Optional second model, used only by the model-swap exercise.
# DEVBUDDY_MODEL_ALT=anthropic/claude-sonnet-4

# --- Week 3 (RAG) ----------------------------------------------
# Qdrant vector database. Start with: docker compose up -d
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=devbuddy-docs
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# RETRIEVAL_K=3

# --- Week 5 (MCP) ----------------------------------------------
# MCP_HOST=127.0.0.1
# MCP_TRANSPORT=streamable-http   # or "sse" for the SDK 1.x path in docs/week-05.md
# MCP_PORT=8000

# --- Week 6 (Agent guards) -------------------------------------
# Hard stops on runaway agents.
# MAX_STEPS=10
# MAX_COST=2.00

# --- Week 7 (LLMOps) -------------------------------------------
# Start the stack first:  docker compose up -d
#
# Every default below already points at that stack, so nothing here needs to
# be set for the local setup to work. Uncomment only to change something.

# Prometheus scrapes this port. Set METRICS_ENABLED=false to stop serving it.
# METRICS_ENABLED=true
# METRICS_PORT=8001

# OpenTelemetry -> Uptrace. The DSN is http://<token>@<host>:<port>/<project_id>;
# the token and project are seeded in ops/uptrace/uptrace.yml.
# TRACING_ENABLED=true
# UPTRACE_DSN=http://devbuddy_project_token@localhost:14318/1
# OTEL_SERVICE_NAME=devbuddy
# OTEL_ENVIRONMENT=local
#
# Nothing in src/ imports an Uptrace SDK — this is plain OTLP. To send traces
# to Jaeger, Tempo, Datadog or New Relic instead, change this one line.

# Langfuse. These keys are seeded by docker-compose.yml via LANGFUSE_INIT_*,
# so the self-hosted stack works with no signup.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-lf-devbuddy-local
# LANGFUSE_SECRET_KEY=sk-lf-devbuddy-local
# LANGFUSE_HOST=http://localhost:3001
#
# To use Langfuse Cloud instead of the six self-hosted containers, create a
# project at cloud.langfuse.com and set all three:
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Guardrails.
# GUARDRAILS_ENABLED=true
# MAX_QUERY_CHARS=2000
# Reports scoring below this against the gathered evidence are refused.
# MIN_GROUNDING_SCORE=0.5
