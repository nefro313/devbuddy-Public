# DevBuddy — Environment Configuration
#
# Copy this file to .env and add your OpenRouter API key.
# .env is git-ignored — never commit real keys.
#
# Every value here is read by src/config.py and nowhere else. Defaults live in
# the Settings class, so you only need to set what you want to override.

OPENROUTER_API_KEY=sk-or-your-key-here

# Default model (any OpenRouter model string).
# Needs reliable structured output + tool calling for Weeks 2-6.
DEVBUDDY_MODEL=openai/gpt-4o-mini

# Optional second model, used only by the model-swap exercise.
# DEVBUDDY_MODEL_ALT=anthropic/claude-sonnet-4

# --- Week 3 (RAG) ----------------------------------------------
# Qdrant vector database. Start with: docker compose up -d
QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=devbuddy-docs
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# RETRIEVAL_K=3

# --- Week 5 (MCP) ----------------------------------------------
# MCP_HOST=127.0.0.1
# MCP_PORT=8000

# --- Week 6 (Agent guards) -------------------------------------
# Hard stops on runaway agents.
# MAX_STEPS=10
# MAX_COST=2.00
