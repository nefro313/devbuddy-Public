# DevBuddy — Environment Configuration
#
# Copy this file to .env and add your OpenRouter API key.
# .env is git-ignored — never commit real keys.

OPENROUTER_API_KEY=sk-or-your-key-here

# Default model (change to any OpenRouter model string).
# Keep gpt-4o-mini for the DEMOS: it reliably supports function calling and strict
# json_schema. Free models (e.g. nvidia/nemotron-...:free) often do NOT — use those
# only for the hands-on "reproduce" step, not for the live structured-output demos.
DEVBUDDY_MODEL=openai/gpt-4o-mini
